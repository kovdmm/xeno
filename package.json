{
  "name": "xeno",
  "version": "1.0.0",
  "description": "PWA (browser) tower defence tactics game",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite --port 3000",
    "deploy": "yarn build && scp -r dist/. root@46.101.198.82:/var/www/xeno.kovalev.app/",
    "maintenance": "scp maintenance/index.html root@46.101.198.82:/var/www/xeno.kovalev.app/index.html",
    "sim": "vitest run --config vitest.sim.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:all": "vitest run && playwright test",
    "test:coverage": "vitest run --coverage",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "typecheck": "tsc && tsc -p tsconfig.test.json && tsc -p tsconfig.sw.json",
    "icons": "tsx scripts/make-icons.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "howler": "2.2.4",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "prettier": {
    "trailingComma": "all",
    "printWidth": 120
  }
}
