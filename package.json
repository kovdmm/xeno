{
  "name": "xeno-tactic",
  "version": "1.0.0",
  "description": "Xeno-Tactic — browser tactics game",
  "private": true,
  "scripts": {
    "start": "npx --yes serve -l 3000 .",
    "deploy": "scp -r index.html style.css js root@46.101.198.82:/var/www/xeno.kovalev.app/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:all": "vitest run && playwright test",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "5.0.5",
    "howler": "2.2.4",
    "prettier": "^3.9.10",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "prettier": {
    "trailingComma": "all",
    "printWidth": 120
  }
}
